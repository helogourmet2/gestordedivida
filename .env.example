# ─── Firebase ────────────────────────────────────────────────────────────────
# Obtenha em: https://console.firebase.google.com
# Configurações do projeto → Seus apps → Web app → firebaseConfig

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# VAPID Key pública para Web Push
# Firebase Console → Cloud Messaging → Configuração da Web → Certificados push da Web
VITE_FIREBASE_VAPID_KEY=

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Obtenha em: https://supabase.com → seu projeto → Settings → API

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Pagamento / trial: ativar somente após preparar banco e funções no Netlify
VITE_BILLING_ENABLED=false

# Somente servidor Netlify (escopo Functions) — nunca prefixar com VITE_
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_ENVIRONMENT=production
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FIREBASE_PROJECT_ID=gestor-dedividas

# URL do backend para usar a cobrança também no site Firebase.
# No Netlify, pode permanecer vazia (usa o próprio domínio).
VITE_BILLING_API_URL=
